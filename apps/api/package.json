{
  "name": "@wa-kijo/api",
  "version": "0.6.1",
  "private": true,
  "description": "NestJS 11 API with Fastify adapter",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @wa-kijo/shared --filter @wa-kijo/db build && dotenv -e ../../.env -- nest start --watch --builder swc",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "dotenv -e ../../.env -- vitest run --config vitest.integration.config.ts",
    "lint": "echo 'ESLint TBD' && exit 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bull-board/api": "^7.0.0",
    "@bull-board/fastify": "^7.0.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^9.1.3",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/swagger": "^11.4.2",
    "@wa-kijo/db": "workspace:*",
    "@wa-kijo/shared": "workspace:*",
    "better-auth": "^1.6.9",
    "bullmq": "^5.76.4",
    "fastify": "^5.0.0",
    "ioredis": "^5.3.0",
    "nestjs-pino": "^4.1.0",
    "nestjs-zod": "^4.0.0",
    "pino-http": "^10.0.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.0",
    "@swc/helpers": "^0.5.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "dotenv-cli": "^8.0.0",
    "pino-pretty": "^13.0.0",
    "testcontainers": "^11.14.0",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
