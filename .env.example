# =====================================================
# wa-kijo — Local Development Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# =====================================================

# ----- Node ---------------------------------------------------
NODE_ENV=development

# ----- PostgreSQL (used by docker-compose AND Prisma) ----------
POSTGRES_USER=wakijo
POSTGRES_PASSWORD=wakijo_dev_password
POSTGRES_DB=wakijo
POSTGRES_PORT=5434

# Prisma uses this — must match the values above
# NOTE: Port 5432 is often claimed by other local Postgres instances.
# 5434 avoids conflicts. Change to 5432 if this machine has no other Postgres.
DATABASE_URL=postgresql://wakijo:wakijo_dev_password@localhost:5434/wakijo?schema=public

# ----- Redis ---------------------------------------------------
# NOTE: 6379 is the Redis default but may conflict. 6381 is a safe fallback.
REDIS_PORT=6381
REDIS_URL=redis://localhost:6381

# ----- API ----------------------------------------------------
API_PORT=3000
API_BASE_URL=http://localhost:3000

# ----- Web ----------------------------------------------------
WEB_PORT=3001
WEB_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ----- Auth (Better Auth) -------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
BETTER_AUTH_URL=http://localhost:3000

# ----- Email (Resend) -----------------------------------------
RESEND_API_KEY=re_xxx_replace_me
EMAIL_FROM=hello@example.com

# ----- Stripe (billing) ---------------------------------------
# Get test keys at https://dashboard.stripe.com/test/apikeys
# The webhook secret is shown after you create a webhook endpoint.
# For local development you can use `stripe listen --forward-to localhost:3000/billing/stripe/webhook`
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ----- Queue admin board (Bull Board) ------------------------
# Set BULL_BOARD_PASSWORD to protect /admin/queues with Basic Auth.
# Exposed in development only. In production, use VPN or IP allowlist.
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=

# ----- OAuth providers (optional) ----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- Observability -----------------------------------------
SENTRY_DSN=
LOG_LEVEL=debug
