# =====================================================
# wa-kijo — Local Development Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# =====================================================

# ----- Node ---------------------------------------------------
NODE_ENV=development

# ----- PostgreSQL (used by docker-compose AND Prisma) ----------
POSTGRES_USER=wakijo
POSTGRES_PASSWORD=wakijo_dev_password
POSTGRES_DB=wakijo
POSTGRES_PORT=5432

# Prisma uses this — must match the values above
DATABASE_URL=postgresql://wakijo:wakijo_dev_password@localhost:5432/wakijo?schema=public

# ----- Redis ---------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ----- API ----------------------------------------------------
API_PORT=3000
API_BASE_URL=http://localhost:3000

# ----- Web ----------------------------------------------------
WEB_PORT=3001
WEB_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ----- Auth (Better Auth) -------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
BETTER_AUTH_URL=http://localhost:3000

# ----- Email (Resend) -----------------------------------------
RESEND_API_KEY=re_xxx_replace_me
EMAIL_FROM=hello@example.com

# ----- Stripe (default billing) -------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ----- Billplz (Malaysian billing alternative) ----------------
BILLPLZ_API_KEY=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_SANDBOX=true

# ----- OAuth providers (optional) -----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- Observability ------------------------------------------
SENTRY_DSN=
LOG_LEVEL=debug
