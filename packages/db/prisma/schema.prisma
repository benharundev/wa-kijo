generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Better Auth core models
// Field names must exactly match what Better Auth 1.5's Prisma adapter
// expects. Do NOT rename these fields without updating the adapter config in
// Phase 3. @@map directives lowercase table names as the adapter expects.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Soft delete (project-wide convention — not managed by Better Auth)
  deletedAt     DateTime?
  deletedBy     String?

  // Audit
  createdBy     String?
  updatedBy     String?

  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[]

  @@index([email])
  @@index([deletedAt])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  // Added by Better Auth organisation plugin — tracks the active org for this session
  activeOrganizationId String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Multi-tenancy models — extend Better Auth's organization plugin schema.
// Better Auth expects: organization, member, invitation (exact model names).
// Added: parentOrgId (hierarchy), orgType (tenant classification).
// role/status stored as String, not Prisma enum — Better Auth compat.
// ---------------------------------------------------------------------------

model Organization {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  logo     String?
  metadata String? // Better Auth stores serialized JSON here

  // Hierarchy — null for root orgs (FR-O02)
  parentOrgId String?
  parent      Organization?  @relation("OrgHierarchy", fields: [parentOrgId], references: [id])
  children    Organization[] @relation("OrgHierarchy")

  // Tenant classification: AGENCY | WORKSPACE | SYSTEM (FR-O03)
  orgType String @default("WORKSPACE")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?
  createdBy String?
  updatedBy String?

  members       Member[]
  invitations   Invitation[]
  contacts      Contact[]
  tags          Tag[]
  conversations Conversation[]

  @@index([slug])
  @@index([parentOrgId])
  @@index([deletedAt])
  @@map("organization")
}

// ── Domain models ─────────────────────────────────────────────────────────────

// A person or business the organisation communicates with.
// phone must be in E.164 format (+601XXXXXXXX) and is unique per org.
model Contact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  phone     String
  name      String
  email     String?
  notes     String?
  source    String?   // manual | import | api | whatsapp
  isBlocked Boolean   @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?
  createdBy String?
  updatedBy String?

  tags          ContactTag[]
  conversations Conversation[]

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@index([phone])
  @@index([name])
  @@index([deletedAt])
  @@map("contact")
}

// Label for grouping contacts within an organisation.
model Tag {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name  String
  color String @default("#6B7280")  // hex colour displayed in the UI
  slug  String                      // URL-safe identifier, auto-derived from name

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts ContactTag[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("tag")
}

// Junction table linking contacts to tags (many-to-many).
model ContactTag {
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([contactId, tagId])
  @@map("contact_tag")
}

// A communication thread between the organisation and a single contact.
// status:  open | closed | snoozed
// channel: whatsapp | email | sms
model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  status  String @default("open")
  channel String @default("whatsapp")

  assignedToUserId String?
  lastMessageAt    DateTime?
  unreadCount      Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?
  createdBy String?

  messages Message[]

  @@index([organizationId])
  @@index([contactId])
  @@index([status])
  @@index([lastMessageAt])
  @@index([assignedToUserId])
  @@index([deletedAt])
  @@map("conversation")
}

// A single message within a conversation.
// organizationId is denormalised for tenant-scoped queries without a join.
// type:      text | image | document | audio | video | template
// direction: inbound | outbound
// status:    queued | sent | delivered | read | failed
model Message {
  id             String       @id @default(cuid())
  organizationId String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  type      String @default("text")
  direction String
  status    String @default("queued")

  body       String?   // null for media-only messages
  mediaUrl   String?   // hosted URL for image / document / audio / video
  externalId String?   // provider message ID — used for dedup and delivery receipts
  metadata   String?   // JSON string — provider-specific payload
  sentAt     DateTime?
  createdBy  String?   // userId for outbound; null for inbound

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@index([organizationId])
  @@index([externalId])
  @@index([direction])
  @@index([status])
  @@map("message")
}

// role: owner | admin | member — lowercase strings, Better Auth default role names
model Member {
  id        String   @id @default(cuid())
  role      String   @default("member")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("member")
}

// role:   owner | admin | member — lowercase, Better Auth compat
// status: pending | accepted | rejected | canceled
model Invitation {
  id        String   @id @default(cuid())
  email     String
  role      String   @default("member")
  status    String   @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  inviterId String
  inviter   User   @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
  @@index([status])
  @@map("invitation")
}
